# Configuración del Servidor
PORT=5000
NODE_ENV=development

# Base de Datos (MongoDB Atlas)
MONGODB_URI=mongodb+srv://usuario:password@cluster0.mongodb.net/inavet_aula?retryWrites=true&w=majority

# Autenticación y Seguridad
JWT_SECRET=super_secret_jwt_key_inavet_2026_change_in_production
JWT_EXPIRES_IN=7d

# Administrador Inicial (se crea automáticamente si no existe)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=InavetAdmin2026!
ADMIN_EMAIL=admin@inavet.com.ar

# ── Producción (Render) ──────────────────────────────────────────────────────
